# Copy to .env for local development. Never commit .env - repo-sanity.mjs
# rejects it. Production values live in systemd's EnvironmentFile
# (see deploy/grange.service and deploy/deploy.sh).

# Phoenix cookie/session signing secret. Required in production; a dev value
# is baked into backend/config/config.exs. Generate with:
#   openssl rand -base64 48
SECRET_KEY_BASE=

# Port the Phoenix endpoint listens on.
PORT=3200

# Optional: path to the SQLite database file. In production it defaults to
# <release-root>/data/grange.sqlite3 (created on first boot). Development and
# test use files under backend/priv/.
DATABASE_PATH=
