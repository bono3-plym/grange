{
  "name": "grange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pnpm install && cd backend && mix deps.get",
    "dev": "concurrently -k -n backend,web -c blue,magenta \"pnpm dev:backend\" \"pnpm dev:web\"",
    "dev:backend": "cd backend && mix phx.server",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:backend": "cd backend && mix test",
    "test:e2e": "vite build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "biome lint && node scripts/max-lines.mjs && pnpm sanity",
    "lint:backend": "cd backend && mix format --check-formatted && mix credo --strict",
    "sanity": "node scripts/repo-sanity.mjs",
    "check": "pnpm lint && pnpm test && pnpm test:backend && pnpm build",
    "format": "biome format --write",
    "start": "cd backend && mix phx.server"
  },
  "dependencies": {
    "@fontsource/rye": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "excalibur": "0.32.0",
    "phoenix": "^1.7.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.15",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}