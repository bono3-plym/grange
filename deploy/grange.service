[Unit]
Description=Grange game server
Documentation=https://github.com/NatTuck/grange
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/grange/grange
Environment=PORT=3200
Environment=RELEASE_DISTRIBUTION=none
EnvironmentFile=-/home/grange/grange.env
ExecStart=/home/grange/grange/bin/grange start
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target